# Backend
DATABASE_URL=postgresql+psycopg://scol:scolpwd@db:5432/scolaris
REDIS_URL=redis://redis:6379/0

# OpenAI
OPENAI_API_KEY=replace-with-your-openai-api-key
MODEL_NAME=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# Local CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Dev auth
RBAC_DISABLED=true
ADMIN_TOKEN=change-me-for-dev
JWT_SECRET=change-me-jwt-secret-for-dev
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=86400
AUTH_PASSWORD_ADMIN=scolarisAdmin
AUTH_PASSWORD_CURATOR=scolarisCurator
AUTH_PASSWORD_VIEWER=scolarisViewer
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=300

# Chat validation and limits
CHAT_ALLOWED_ROLES=consultor,ventas,soporte
CHAT_MAX_QUESTION_CHARS=800
STRICT_VALIDATION=true
RATE_LIMIT_ENABLED=true
CHAT_IP_LIMIT=30
CHAT_ID_LIMIT=15
CHAT_RATE_WINDOW_SECONDS=300

# Timeouts
AGENT_TIMEOUT_SECONDS=25
LLM_TIMEOUT_SECONDS=20
EMBED_TIMEOUT_SECONDS=10

# Metrics
METRICS_WINDOW_SECONDS=3600
METRICS_MAX_SAMPLES=2000
METRICS_MAX_EVENTS=5000

# Uploads and ingestion
UPLOAD_ASYNC_ENABLED=true
UPLOAD_QUEUE_NAME=ingest:default
MAX_UPLOAD_MB=20
ALLOWED_EXTS=.pdf,.docx,.txt,.md,.html
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown,text/html
UPLOAD_MAX_PAGES=200
UPLOAD_MAX_PARAGRAPHS=2000
UPLOAD_AV_POLICY=allow

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
